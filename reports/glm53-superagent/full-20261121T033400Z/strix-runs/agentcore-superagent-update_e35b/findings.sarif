          },
          "properties": {
            "security-severity": "3.1",
            "strix_vuln_class_hash": "dc127a846ef9bac99689f20e10cc3507f41450c56ab34a9396c42922d460b55f",
            "synthetic_location": true,
            "strix": {
              "id": "vuln-0024",
              "severity": "low",
