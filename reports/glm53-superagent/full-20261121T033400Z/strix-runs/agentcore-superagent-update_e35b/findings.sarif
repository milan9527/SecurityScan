            },
            {
              "id": "strix-coverage/container-security-root-user-privileged-exposed-ports-embedded-credentials",
              "name": "Container security: root user, privileged, exposed ports, embedded credentials",
              "shortDescription": {
                "text": "Coverage: Container security: root user, privileged, exposed ports, embedded credentials"
              },
              "fullDescription": {
                "text": "Coverage of Container security: root user, privileged, exposed ports, embedded credentials across the assessed attack surface."
              },
              "defaultConfiguration": {
                "level": "none"
