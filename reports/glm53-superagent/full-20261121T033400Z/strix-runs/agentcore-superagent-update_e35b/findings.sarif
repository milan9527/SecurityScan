          "ruleId": "CWE-287",
          "ruleIndex": 21,
          "level": "warning",
          "message": {
            "text": "IM webhook signature verification fails open — unauthenticated message injection into agent sessions\n\nIM inbound webhook signature verification fails open: Slack, Telegram, DingTalk, Feishu and WhatsApp adapters return true when no secret is configured, and Discord/WeCom adapters always return true, so unauthenticated POSTs to the public /api/im/* webhook routes are accepted and injected into the org's agent chat pipeline whenever a binding exists without a stored secret."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "SECURITY.md"
                }
              }
            },
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "super-agent/backend",
                  "kind": "resource"
                }
