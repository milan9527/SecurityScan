        },
        {
          "ruleId": "strix-coverage/incorrect-boto3-api-usage-body-passed-as-dict-vs-blob-bytes-and-unvalidated-runtime-response-handling",
          "ruleIndex": 3,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Incorrect boto3 API usage (body passed as dict vs blob/bytes) and unvalidated runtime response handling — Ruled out: shell_client.py (AgentCoreShell.run / invoke_agent)\n\nVerified against the bundled botocore service model (offline, no AWS call): `InvokeAgentRuntimeCommand.body` is a structure with members {command, timeout} and is required — the dict passed in shell_client.py:49-55 is the correct shape. `InvokeAgentRuntime.payload` is a blob and is passed json.dumps().encode(), also correct. Response parsing iterates documented chunk events only; no eval/exec/format sinks on runtime data."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "shell_client.py (AgentCoreShell.run / invoke_agent)"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "ruled_out",
              "risk_area": "Incorrect boto3 API usage (body passed as dict vs blob/bytes) and unvalidated runtime response handling",
              "surface": "shell_client.py (AgentCoreShell.run / invoke_agent)",
              "recorded_by": "Root Agent",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/hardcoded-credentials-secret-exposure",
          "ruleIndex": 4,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Hardcoded credentials / secret exposure — Ruled out: config.py\n\nconfig.py contains only a runtime ARN, region, and a UUID session id — an identifier, not a credential (no access key, secret, or token). Per engagement rules, ARNs/account IDs are not reported as credentials. Hygiene note only: identifiers embedded in VCS should ideally come from config, which the env-var override already permits."
          },
