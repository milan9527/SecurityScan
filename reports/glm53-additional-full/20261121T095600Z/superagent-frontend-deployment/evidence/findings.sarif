            {
              "id": "strix-coverage/markdown-rendering-of-agent-output-raw-html-link-safety",
              "name": "markdown rendering of agent output (raw HTML, link safety)",
              "shortDescription": {
                "text": "Coverage: markdown rendering of agent output (raw HTML, link safety)"
