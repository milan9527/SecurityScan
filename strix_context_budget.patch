+
+
+def test_deployment_budget_overrides_metadata(monkeypatch: pytest.MonkeyPatch) -> None:
+    settings = load_settings()
+    monkeypatch.setattr(settings.context, "context_tokens_override", 262_144)
+    monkeypatch.setattr(settings.context, "output_tokens_override", 32_768)
+    monkeypatch.setattr(context_budget, "_model_info", lambda _: {
+        "max_input_tokens": 1_000_000, "max_output_tokens": 8_192,
+    })
+    assert context_budget.context_window("openai/glm-5.3") == 262_144
+    assert context_budget.output_limit("openai/glm-5.3") == 32_768
